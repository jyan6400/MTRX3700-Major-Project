# Group 26 - the beacon visual odometry on the bench, with the JTAG photo (golden/vo/README_VO.md).
# FrameGrabJtag V2026.3's project (its pins and settings, unchanged) with vision_grab_top as the top level:
# the team repo's camera code (vendor/camera), the robot's vision chain (rtl/), the frame grab
# (golden/framegrab/vendor) and the result words (golden/framegrab/rtl). Paths are from this folder.
set_global_assignment -name TOP_LEVEL_ENTITY vo_grab_top
set_global_assignment -name SYSTEMVERILOG_FILE ../../../vendor/camera/rtl/camera_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../vendor/camera/rtl/clock_divider.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../vendor/camera/rtl/i2c_master.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../vendor/camera/rtl/ov7670_config.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../vendor/camera/rtl/ov7670_capture.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../vendor/camera/rtl/frame_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../vendor/camera/rtl/camera_display.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../vendor/camera/rtl/video_pll.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/integration/camera_stream_adapter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/image_processing/led_colour_mask.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/image_processing/colour_run_filter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/vo/vo_divider.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/vo/beacon_detect.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/vo/vo_mailbox_cdc.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/vo/beacon_geometry.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/vo/beacon_tracker.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/vo/vo_standoff.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/vo/beacon_vo.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../rtl/vo/vo_hex_display.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../golden/framegrab/vendor/rtl/ov7670_hold.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../golden/framegrab/vendor/rtl/snapshot_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../golden/framegrab/vendor/rtl/snapshot_probes.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../golden/framegrab/vendor/rtl/frame_snap.sv
# The Platform Designer system with the VGA Controller (the camera project's, copied here so Quartus generates it here)
set_global_assignment -name SYSTEMVERILOG_FILE ../../../golden/framegrab/rtl/vo_grab_results.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../../golden/framegrab/rtl/vo_grab_top.sv
# vo_calibration.svh (vo_calibrate.py writes it) is `included from rtl/vo
set_global_assignment -name SEARCH_PATH ../../../rtl/vo
set_global_assignment -name QSYS_FILE vga_sink.qsys
set_global_assignment -name SDC_FILE vo_grab.sdc
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
