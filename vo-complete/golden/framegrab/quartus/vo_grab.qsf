set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to GPIO_1[9]

# the camera's data, HREF and VSYNC: captured in the I/O cell flops (ov7670_capture registers them straight off the pin)
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[12]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[13]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[14]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[15]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[16]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[17]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[18]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[19]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[22]
set_instance_assignment -name FAST_INPUT_REGISTER ON -to GPIO_1[23]
# XCLK (GPIO_1[20]) drives the camera down the ribbon: a gentle edge (4 mA, slow slew) means less overshoot
# and less crosstalk onto PCLK.
set_instance_assignment -name CURRENT_STRENGTH_NEW 4MA -to GPIO_1[20]
set_instance_assignment -name SLEW_RATE 0 -to GPIO_1[20]
# SIO_D and SIO_C (the camera's SCCB) need pull-ups. If the adaptor's are missing or broken, the camera is never
# configured: it sends its default YUV, a dark red, speckled picture, while the design still reports it configured
# (SIO_D stays low, so every write looks acknowledged). The FPGA's own weak pull-ups (about 25 kOhm) are enough on
# their own, and do no harm beside the adaptor's.
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_1[24]
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to GPIO_1[25]
# the six 7-segment displays (the team's hardware/de1-soc-pins.csv)
